rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function validName(n) { return n is string && n.matches('^[a-z0-9_]{3,16}$'); }
    function validAvatar(a) { return a is int && a >= 0 && a <= 8; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }

    // Unique-username registry. A name can be claimed once, never changed or freed.
    // One name per account: it must be created in the same batch as that account's first profile,
    // and the profile must carry this name.
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && validName(name)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is number
        && !exists(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.username == name;
      allow update, delete: if false;
    }

    // Player profiles. Creation must be in the same batch as the username claim and starts at zero.
    // Afterwards a profile changes in only two ways: a new avatar, or the stats that go with a new result.
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'avatar', 'streak', 'bestStreak', 'totalPoints', 'solved', 'lastDate', 'createdAt'])
        && request.resource.data.uid == uid
        && validName(request.resource.data.username)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
        && validAvatar(request.resource.data.avatar)
        && request.resource.data.streak == 0 && request.resource.data.bestStreak == 0
        && request.resource.data.totalPoints == 0 && request.resource.data.solved == 0
        && request.resource.data.lastDate == null
        && request.resource.data.createdAt is number;
      allow update: if signedIn() && request.auth.uid == uid && (avatarOnly() || statsWithNewEntry(uid));
      allow delete: if false;
    }
    function avatarOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar'])
        && validAvatar(request.resource.data.avatar);
    }
    // Stats may only move together with a result that is being created in this same batch (named by
    // lastGame): one more solve, exactly that result's score, and a streak that grows by at most one.
    function statsWithNewEntry(uid) {
      let d = request.resource.data;
      let old = resource.data;
      let entry = /databases/$(database)/documents/days/$(d.lastGame)/entries/$(uid);
      return d.diff(old).affectedKeys().hasOnly(['streak', 'bestStreak', 'lastDate', 'totalPoints', 'solved', 'lastGame'])
        && d.lastGame is string
        && !exists(entry) && existsAfter(entry)
        && d.lastDate == d.lastGame[0:10]
        && d.solved == old.get('solved', 0) + 1
        && d.totalPoints == old.get('totalPoints', 0) + getAfter(entry).data.score
        && d.streak is int && d.streak >= 1 && d.streak <= old.get('streak', 0) + 1
        && d.bestStreak is int && d.bestStreak >= old.get('bestStreak', 0)
        && (d.bestStreak == old.get('bestStreak', 0) || d.bestStreak == d.streak);
    }

    // Daily results: days/{YYYY-MM-DD_<game>}/entries/{uid}, where <game> is level_easy, level_moderate,
    // level_hard or time. One write per player per board. (Plain _level ids are older results, now read-only.)
    // Scores are computed by the player's device, so they cannot be proven here; these checks keep every
    // field to a known type and a value the scoring formula could actually produce.
    match /days/{dayId}/entries/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && dayId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_(level_(easy|moderate|hard)|time)$')
        && nearToday(dayId)
        && validEntry(dayId, uid);
      allow update, delete: if false;
    }
    // The day in the id must be the server's date, give or take one day for time zones.
    function dayNum(t) { return t.year() * 10000 + t.month() * 100 + t.day(); }
    function nearToday(dayId) {
      let n = int(dayId[0:4]) * 10000 + int(dayId[5:7]) * 100 + int(dayId[8:10]);
      return n == dayNum(request.time)
        || n == dayNum(request.time + duration.value(1, 'd'))
        || n == dayNum(request.time - duration.value(1, 'd'));
    }
    function validEntry(dayId, uid) {
      let d = request.resource.data;
      let game = dayId[11:dayId.size()];
      return d.keys().hasOnly(['uid', 'username', 'mode', 'date', 'level', 'diff', 'score', 'sortKey', 'adj', 'ms', 'mistakes', 'hints', 'stars', 'avatar', 'at'])
        && d.keys().hasAll(['uid', 'username', 'mode', 'date', 'level', 'score', 'sortKey', 'adj', 'ms', 'mistakes', 'hints', 'stars', 'avatar', 'at'])
        && d.uid == uid
        && d.username == get(userPath(uid)).data.username
        && d.date == dayId[0:10]
        && d.level is int && d.level >= 1 && d.level <= 365
        && d.ms is int && d.ms >= 0 && d.ms <= 86400000
        && d.mistakes is int && d.mistakes >= 0 && d.mistakes <= 2
        && d.hints is int && d.hints >= 0 && d.hints <= 200
        && d.stars is int && d.stars >= 1 && d.stars <= 3
        && validAvatar(d.avatar)
        && d.at is number
        && d.adj is number
        && d.adj >= d.ms + d.mistakes * 15000 + d.hints * 30000 - 1
        && d.adj <= d.ms + d.mistakes * 15000 + d.hints * 30000 + 1
        && d.score is int
        && d.sortKey is number
        && (game == 'time' ? validTime(d) : validLevel(d, game));
    }
    // Time Attack: ranked by adjusted time; points are 100..1000.
    function validTime(d) {
      return d.mode == 'time' && !('diff' in d)
        && d.score >= 100 && d.score <= 1000
        && d.sortKey == d.adj;
    }
    // Score Attack: score = base + speed bonus (200 minus one point per 1.5 s, never below 0)
    // - 50 per wrong pet - 75 per hint, never below 50. sortKey orders by score, then time.
    function validLevel(d, game) {
      let base = game == 'level_easy' ? 300 : (game == 'level_moderate' ? 550 : 800);
      let pen = d.mistakes * 50 + d.hints * 75;
      return d.mode == 'level' && d.diff == game[6:game.size()]
        && d.score >= 50
        && (d.score == 50
          || (d.ms >= 300000 && d.score <= base - pen)
          || (d.ms < 300000 && d.score <= base - pen + 201 - d.ms / 1500.0))
        && d.sortKey >= (2000 - d.score) * 1000000
        && d.sortKey < (2000 - d.score) * 1000000 + 1000000;
    }
  }
}
